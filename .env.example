# Firebase Client (public - exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side only - NEVER expose to client)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_NAME=KOPPAFOOT
NEXT_PUBLIC_APP_URL=http://localhost:3000

# football-data.org (server-side only — real football content on the home)
# Free token from https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Frein d'urgence de la connexion par SMS (lib/phone) : ouverte par défaut,
# `0` la referme (et l'ajout d'un numéro au profil). Figé à la construction.
# NEXT_PUBLIC_CONNEXION_SMS=0

# FedaPay (server-side only) — paiement mobile (lib/fedapay, lib/paiement-serveur).
# Sans clé secrète, rien n'est en vente. FEDAPAY_ENV=live en production
# seulement ; toute autre valeur vaut bac à sable, où seul un superadmin peut
# acheter (le poste de dev et les aperçus écrivent dans la base de production).
# Le secret du webhook est celui de l'endpoint créé dans le tableau de bord
# FedaPay : un par endpoint, différent en test et en réel.
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENV=sandbox
