rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Helper Functions
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    function isRole(role) {
      let profile = getProfile();
      return profile != null && profile.user_type == role;
    }

    function isSuperAdmin() {
      let profile = getProfile();
      return profile != null && (profile.user_type == 'superadmin' || profile.is_superadmin == true);
    }

    function isConfirmedReferee(matchId) {
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return exists(matchPath) &&
             get(matchPath).data.referee_id == request.auth.uid &&
             get(matchPath).data.referee_status == 'confirmed';
    }

    function isOrganizerOf(cid) {
      let p = /databases/$(database)/documents/competitions/$(cid);
      return isAuthenticated() && exists(p) && request.auth.uid in get(p).data.organizer_ids;
    }

    function isModeratorOf(cid) {
      let p = /databases/$(database)/documents/competitions/$(cid);
      // .get(..., []) so older competitions without the field don't error.
      return isAuthenticated() && exists(p) && request.auth.uid in get(p).data.get('moderator_ids', []);
    }

    // ── Staff access codes ────────────────────────────────
    // A redeemed code writes competitions/{cid}/staff_grants/{uid}. That doc
    // is what lets a volunteer with no role on the platform run the live
    // console — but only on the matches its `scope` names, only until it
    // expires, and only until the organizer revokes it. Grants are written by
    // the admin SDK exclusively (see the write rule below), so what is read
    // here can be trusted.

    function staffGrantOf(cid) {
      let p = /databases/$(database)/documents/competitions/$(cid)/staff_grants/$(request.auth.uid);
      return isAuthenticated() && exists(p) ? get(p).data : null;
    }

    /** Le role choisi sur /evolution, independant du type de compte. */
    function isEvolutionRole(role) {
      let profile = getProfile();
      return profile != null && profile.get('evolution_role', null) == role;
    }

    function grantIsLive(g) {
      return g != null
        && g.get('revoked', false) == false
        && (g.get('expires_at_ms', null) == null
            || request.time.toMillis() < g.get('expires_at_ms', 0));
    }

    // What the winner of `srcMid` feeds into. A match-scoped grant has to be
    // able to write that one other document: finishing a knockout match pushes
    // the winner into the next round, and without this the console would save
    // the result and then fail half-way.
    function feedsInto(cid, srcMid) {
      let p = /databases/$(database)/documents/competitions/$(cid)/comp_matches/$(srcMid);
      return exists(p) ? get(p).data.get('feeds_into_match_id', null) : null;
    }

    // Reads `resource.data` — the match being written, which exists because
    // grants are only ever consulted on update, never on create.
    function grantCoversMatch(cid, mid, g) {
      let scope = g.get('scope', {});
      let kind = scope.get('kind', '');
      return kind == 'competition'
        || (kind == 'stage' && resource.data.stage == scope.get('stage', ''))
        || (kind == 'group' && resource.data.get('group', null) == scope.get('group', ''))
        || (kind == 'match'
            && (scope.get('match_id', '') == mid
                || feedsInto(cid, scope.get('match_id', '')) == mid));
    }

    function hasStaffGrantFor(cid, mid) {
      let g = staffGrantOf(cid);
      return grantIsLive(g) && grantCoversMatch(cid, mid, g);
    }

    function isTeamManagerOf(cid, tid) {
      let p = /databases/$(database)/documents/competitions/$(cid)/comp_teams/$(tid);
      return isAuthenticated() && exists(p)
        && get(p).data.get('claimed_by_manager_id', null) == request.auth.uid;
    }

    // Fields a team manager may touch on their own comp_team doc. Notably
    // absent: name, group and claimed_by_manager_id — those decide the
    // competition itself and stay with the organizer.
    // claimed_by_team_id IS allowed: linking their own club to their own
    // competition entry is the manager's call. It is a back-reference only —
    // nothing authorizes off it — so a wrong id costs a broken link, not access.
    function managerEditableTeamFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['players', 'short_name', 'logo_url', 'color',
                  'claimed_by_team_id', 'updated_at']);
    }

    function noProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['email', 'user_type', 'is_superadmin', 'is_active', 'created_at']);
    }

    // Évolution onboarding: the owner may flip their own user_type, but only
    // between the non-privileged roles (never to/from organizer/superadmin —
    // those transitions stay admin-SDK only), together with the onboarding
    // profile fields.
    function isRoleEvolution() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'user_type', 'evolution_role', 'position', 'skill_level',
          'strong_foot', 'team_name', 'location_city', 'updated_at',
          // Le rôle arbitre est activable librement depuis /evolution : son
          // formulaire écrit le niveau et le numéro de licence. Sans ces deux
          // clés ici, `hasOnly` rejetait l'activation entière.
          //
          // Personne ne vérifie ce numéro : il sert à se présenter aux
          // organisateurs, pas à valider quoi que ce soit. Le laisser écrire
          // par son propriétaire n'accorde donc aucun pouvoir.
          'license_level', 'license_number'
        ])
        // « referee » rejoint les cibles possibles — il était déjà accepté en
        // valeur de DÉPART, ce qui laissait un arbitre historique changer de
        // rôle sans pouvoir le redevenir. Organisateur et superadmin restent
        // hors de ce chemin, des deux côtés : ces transitions passent par le
        // SDK admin.
        && request.resource.data.user_type in ['player', 'manager', 'referee', 'venue_owner']
        && resource.data.user_type in ['player', 'manager', 'referee', 'venue_owner'];
    }

    // ============================================
    // Users collection
    // ============================================
    match /users/{uid} {
      // Was `if true`. A user document carries the account's email and phone
      // number, so world-readable meant anyone, signed in or not, could walk
      // the collection and harvest every contact detail on the platform.
      //
      // No public route reads profiles — the login-free pages (accueil,
      // /competitions, /c/**, /staff/rejoindre, /invitations) work off
      // competitions, comp_teams and comp_matches, and posts carry their
      // author's name and avatar denormalized. Requiring an account matches how
      // /teams is already gated.
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      
      // Only the owner writes their own profile.
      //
      // Two branches used to sit here letting ANY signed-in user write
      // `followers_count`, or `matches_played`/`goals`/`assists`, on ANY user —
      // the only way to express "the follow button" and "the end-of-match
      // rollup" in rules, since both write counters on someone else's document.
      // In practice they meant anyone could rewrite anyone's career stats or
      // follower count. Both operations moved to the admin SDK
      // (/api/follows, /api/matches/complete), which bypasses these rules, so
      // the branches are gone rather than narrowed.
      allow update: if (isOwner(uid) && noProtectedFields())
                   || (isOwner(uid) && isRoleEvolution());

      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Venues collection
    // ============================================
    match /venues/{venueId} {
      // Lecture publique : un terrain est une annonce faite pour etre trouvee.
      // Le document ne porte que ce qu'on publie volontairement — nom,
      // adresse, format, surface — et aucune coordonnee personnelle : celles
      // du proprietaire restent dans `users`, ferme.
      allow read: if true;

      // Creation : le TYPE DE COMPTE ne suffit plus. Depuis que le terrain est
      // un role Evolution activable, un organisateur qui reference son terrain
      // garde `user_type: "organizer"` — `isRole('venue_owner')` seul lui
      // aurait refuse la creation. Le role Evolution vaut donc autorisation,
      // au meme titre.
      allow create: if isAuthenticated()
                    && request.resource.data.owner_id == request.auth.uid
                    && (isRole('venue_owner') || isEvolutionRole('venue_owner'));
      allow update: if isAuthenticated() && (resource.data.owner_id == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.owner_id == request.auth.uid || isSuperAdmin());
    }

    // ============================================
    // Bookings collection
    // ============================================
    // Demandes de créneau.
    //
    // Lecture réservée aux deux parties : une demande dit qui joue où et
    // quand, ça ne regarde que le demandeur et le propriétaire. Les créneaux
    // OCCUPÉS sont publiés séparément par /api/public/venue/[id]/slots, qui
    // ne sort que la date et l'heure — jamais le nom du demandeur.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated()
        && (resource.data.owner_id == request.auth.uid || resource.data.user_id == request.auth.uid || isSuperAdmin());

      // `create` était ouvert à tout compte connecté, sans contrainte sur le
      // contenu : on pouvait donc déposer une demande au nom de quelqu'un
      // d'autre, ou l'écrire déjà confirmée. Le demandeur est désormais
      // forcément l'auteur, et toute demande naît en attente.
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.venue_id is string
                    && request.resource.data.owner_id is string;

      // Confirmer est le geste du PROPRIÉTAIRE. L'ancienne règle laissait les
      // deux parties écrire n'importe quel statut : un demandeur pouvait
      // confirmer sa propre réservation, ce qui vidait l'accord de son sens.
      // Il lui reste l'annulation, qui est légitimement la sienne.
      allow update: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid
        || (resource.data.user_id == request.auth.uid
            && request.resource.data.status == 'cancelled')
        || isSuperAdmin()
      );

      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Teams collection
    // ============================================
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (
          resource.data.manager_id == request.auth.uid
          || isSuperAdmin()

          // A third branch used to let any signed-in user add themselves to
          // member_ids, as long as they kept the existing members, the manager
          // and the name. It could check the shape of the write but never its
          // reason, so no invitation was actually required: anyone could join
          // any team. Accepting an invitation now goes through
          // /api/team-invitations/respond, which verifies one exists and names
          // the caller; a manager accepting a join request is already covered
          // by the manager_id branch above.
          // The club record (matches_played/wins/losses/draws/goals_for/
          // goals_against/last_match_id) and followers_count used to be writable
          // by any signed-in user here, so that the browser could run the
          // end-of-match rollup and the follow button. That let anyone rewrite
          // any club's record. Both now go through the admin SDK
          // (/api/matches/complete, /api/follows).
        );
      allow delete: if isAuthenticated() && (resource.data.manager_id == request.auth.uid || isSuperAdmin());
    }

    // ============================================
    // Matches collection
    // ============================================
    // Les branches 3 et 4 utilisaient `hasAny`, qui ne contraint QUE la
    // présence d'une clé parmi la liste : toutes les autres restaient
    // librement modifiables. N'importe quel compte authentifié pouvait donc
    // réécrire le statut, le score ou le résultat de n'importe quel match.
    // Tant que la surface était au placard c'était théorique — plus depuis
    // le dégel du matchmaking. Passage en `hasOnly` + contrôle de l'acteur.
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && (request.resource.data.manager_id == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated()
        && (
          // 1. Managers/Admins — away_manager_id vaut "" pour un adversaire
          //    fantôme (aucun compte en face) ; un uid n'est jamais vide.
          resource.data.manager_id == request.auth.uid
          || resource.data.get('away_manager_id', '') == request.auth.uid
          || isSuperAdmin()

          // 2. Confirmed Referee
          || (resource.data.referee_id == request.auth.uid && resource.data.referee_status == 'confirmed')

          // 3. Arbitre, en self-service : se porter candidat sur un match sans
          //    arbitre, ou accepter/décliner sa propre désignation. Les
          //    réponses côté manager (accepter/inviter) passent par la
          //    branche 1.
          || (
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['referee_id', 'referee_name', 'referee_status', 'updated_at'])
               && (
                    (
                      resource.data.get('referee_id', null) == null
                      && request.resource.data.referee_id == request.auth.uid
                      && request.resource.data.referee_status == 'pending'
                    )
                    || resource.data.referee_id == request.auth.uid
                  )
             )

          // 4. Compteurs de confirmation joueur (respondToParticipation).
          //    On ne peut pas vérifier en règles que l'appelant est convoqué :
          //    l'id du doc participation n'est pas dérivable du match. On borne
          //    donc au jeu de champs exact plus la SEULE transition de statut
          //    légitime de ce flux (pending -> upcoming quand le quota est
          //    atteint) — impossible de basculer un match en live, completed
          //    ou cancelled par ce chemin.
          || (
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['confirmed_home', 'confirmed_away', 'players_confirmed', 'status', 'updated_at'])
               && (
                    request.resource.data.status == resource.data.status
                    || (resource.data.status == 'pending' && request.resource.data.status == 'upcoming')
                  )
             )
        );
      allow delete: if isAuthenticated() && (resource.data.manager_id == request.auth.uid || isSuperAdmin());

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }

    // ============================================
    // Invitations collection
    // ============================================
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (resource.data.sender_id == request.auth.uid || resource.data.receiver_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.sender_id == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.sender_id == request.auth.uid || (resource.data.receiver_id == request.auth.uid && request.resource.data.status in ['accepted', 'declined', 'pending']));
      allow delete: if isAuthenticated() && resource.data.sender_id == request.auth.uid;
    }

    // ============================================
    // Participations collection
    // ============================================
    match /participations/{participationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (
          resource.data.player_id == request.auth.uid
          || (
            exists(/databases/$(database)/documents/matches/$(resource.data.match_id)) &&
            (get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.manager_id == request.auth.uid ||
             get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.away_manager_id == request.auth.uid ||
             get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.referee_id == request.auth.uid)
          )
          // The third leg of the same rollup: a branch letting any signed-in
          // user write goals/assists/matches_played on any match sheet. Removed
          // with the other two — /api/matches/complete writes these now.
        );
      allow delete: if isAuthenticated() && (resource.data.player_id == request.auth.uid || (exists(/databases/$(database)/documents/matches/$(resource.data.match_id)) && get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.manager_id == request.auth.uid));
    }

    // ============================================
    // Others (Posts, Follows, etc.)
    // ============================================
    // A like adds or removes the caller's OWN uid from `likes`, and nothing
    // else. Without this, only an author could update their post, so liking
    // anyone else's was denied — the whole point of a feed.
    // Written on membership + size rather than array equality on purpose:
    // arrayRemove takes the uid out wherever it sits, so comparing against a
    // concat only holds when it happened to be last. Requiring the caller's
    // own membership to flip AND the size to move by exactly one also rules
    // out swapping someone else's like for your own in a single write.
    function likesOwnUidOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (
          (
            // adding
            !(request.auth.uid in resource.data.likes)
            && request.auth.uid in request.resource.data.likes
            && request.resource.data.likes.size() == resource.data.likes.size() + 1
          ) || (
            // removing
            request.auth.uid in resource.data.likes
            && !(request.auth.uid in request.resource.data.likes)
            && request.resource.data.likes.size() == resource.data.likes.size() - 1
          )
        );
    }

    // Commenting bumps the counter on a post the commenter does not own.
    function bumpsCommentCountOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment_count'])
        && request.resource.data.comment_count is int
        && request.resource.data.comment_count >= 0;
    }

    // Display identity of the official Tribune account. Everyone reads it —
    // the feed resolves it on every official post — and only the admin SDK
    // writes it, from the superadmin-gated route.
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      // A post must be signed by its writer. Without the author_id check any
      // logged-in account could publish as "system" and wear the official
      // badge; official posts are written by the admin SDK, which bypasses
      // these rules entirely.
      allow create: if isAuthenticated()
                    && request.resource.data.author_id == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.author_id == request.auth.uid
        || likesOwnUidOnly()
        || bumpsCommentCountOnly()
      );
      allow delete: if isAuthenticated() && (resource.data.author_id == request.auth.uid || isSuperAdmin());
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (resource.data.author_id == request.auth.uid || isSuperAdmin());
      }
    }

    // Written only by /api/follows (admin SDK), which creates the follow and
    // moves both counters in one transaction. A client-side write could do the
    // first half and not the second, so it is refused outright.
    match /follows/{followId} {
      allow read: if true;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated();
    }

    match /shortlists/{shortlistId} {
      allow read, delete: if isAuthenticated() && resource.data.manager_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.manager_id == request.auth.uid;
    }

    match /join_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.player_id == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.player_id == request.auth.uid || resource.data.manager_id == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.manager_id == request.auth.uid;
    }

    match /trainings/{trainingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.manager_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.manager_id == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.manager_id == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'updated_at']));
    }

    match /player_ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (request.resource.data.rated_by == request.auth.uid || resource.data.rated_by == request.auth.uid);
    }

    // Pronostics « qui va gagner ? ».
    //
    // L'identifiant du document EST la contrainte : match__uid. Un compte ne
    // peut donc physiquement pas déposer deux pronostics sur le même match,
    // sans qu'aucune requête de comptage soit nécessaire pour le vérifier.
    //
    // Lecture réservée à l'auteur : le rail affiche des totaux, pas des noms.
    // Ces totaux sont calculés par /api/matches/[mid]/predictions avec le SDK
    // admin — c'est ce qui permet de garder les votes individuels fermés tout
    // en publiant le résultat.
    match /match_predictions/{predictionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && predictionId == request.resource.data.match_id + '__' + request.auth.uid
                    && request.resource.data.pick in ['home', 'draw', 'away'];
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.match_id == resource.data.match_id
                    && request.resource.data.pick in ['home', 'draw', 'away'];
      // Un pronostic se change, il ne s'efface pas : sinon on pourrait voter,
      // effacer, revoter pour gonfler un camp.
      allow delete: if false;
    }

    // Same as /follows: /api/follows owns the write, counter included.
    match /team_follows/{followId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /teams/{teamId}/ghost_players/{ghostId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.manager_id == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.manager_id == request.auth.uid;
    }

    // ============================================
    // Competitions (public read, organizer write)
    // ============================================
    match /competitions/{cid} {
      allow read: if true;
      allow create: if isRole('organizer')
                    && request.auth.uid in request.resource.data.organizer_ids;
      allow update, delete: if isOrganizerOf(cid) || isSuperAdmin();

      match /comp_teams/{tid} {
        allow read: if true;
        allow create, delete: if isOrganizerOf(cid) || isSuperAdmin();
        // The team's manager runs their own squad: roster, kit colour, crest.
        // Everything that decides the competition itself — the team's name,
        // its poule, who manages it — stays with the organizer.
        allow update: if isOrganizerOf(cid) || isSuperAdmin()
                      || (isTeamManagerOf(cid, tid) && managerEditableTeamFields());
      }
      match /comp_matches/{mid} {
        allow read: if true;
        // Creating and deleting matches is shaping the competition itself —
        // that stays with the organizer and the moderators they named.
        allow create, delete: if isOrganizerOf(cid) || isModeratorOf(cid) || isSuperAdmin();
        // Updating is what covering a match means (score, clock, events), so
        // it also opens to a live, in-scope access-code holder.
        allow update: if isOrganizerOf(cid) || isModeratorOf(cid) || isSuperAdmin()
                      || hasStaffGrantFor(cid, mid);
      }

      // Access-code grants. Written by the API only: the admin SDK bypasses
      // rules, so denying every client write here means a holder can neither
      // widen their own scope nor un-revoke themselves.
      match /staff_grants/{gid} {
        allow read: if isOrganizerOf(cid) || isSuperAdmin()
                    || (isAuthenticated() && resource.data.uid == request.auth.uid);
        allow write: if false;
      }
    }

    // A code is a secret. It is readable through the organizer API and
    // nowhere else — never by a client, not even the organizer's browser.
    match /staff_codes/{code} {
      allow read, write: if false;
    }

    // Collection-group read of the grants — the live space asks "which
    // competitions did I redeem a code for?" and can only ever see its own.
    match /{path=**}/staff_grants/{gid} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Collection-group read of comp_teams — the manager's "Mon équipe" screen
    // finds their teams across every competition. Rosters are public anyway
    // (the nested rule above already allows read: if true).
    match /{path=**}/comp_teams/{tid} {
      allow read: if true;
    }
  }
}
