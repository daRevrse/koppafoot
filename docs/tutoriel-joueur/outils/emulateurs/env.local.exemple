# Copier à la racine du dépôt sous le nom .env.local (déjà ignoré par git).
# Projet « demo-* » : les émulateurs n'appellent jamais un vrai projet Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-koppafoot.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-koppafoot
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-koppafoot.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo
FIREBASE_PROJECT_ID=demo-koppafoot
FIREBASE_CLIENT_EMAIL=demo@demo-koppafoot.iam.gserviceaccount.com
# Une clé jetable, sans aucune valeur : openssl genrsa 2048, sur une ligne avec des \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-koppafoot
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_APP_NAME=KOPPAFOOT
NEXT_PUBLIC_APP_URL=http://localhost:3000
