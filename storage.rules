rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile assets
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Post media
    match /posts/{postId}/media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Team assets: logo, banner, gallery
    match /teams/{teamId}/logo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /teams/{teamId}/banner/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /teams/{teamId}/gallery/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Competition assets: logo, banner, and per-match banners. Public read;
    // any authenticated user may write (organizer role is enforced by the
    // Firestore rules that gate the competition docs these images belong to).
    match /competitions/{cid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Picture of the official Tribune account. Public to read, never writable
    // from a browser: the file goes through /api/admin/tribune, whose admin
    // SDK bypasses these rules after checking the caller is a superadmin.
    //
    // This used to allow writes gated on a cross-service firestore.get() of
    // the caller's user_type. It returned 403 in production, and a rule that
    // can only be tested by deploying it is the wrong place for an
    // authorization check that the route already performs.
    match /branding/tribune/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all deny
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
